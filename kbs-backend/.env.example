# Environment
NODE_ENV=production
PORT=8080
APP_NAME=KBS Buildings

# Frontend URL
FRONTEND_URL=https://votre-frontend.onrender.com
CORS_ORIGIN=https://votre-frontend.onrender.com

# Database Configuration - Render/Clever Cloud
# Option 1: variables classiques
DB_HOST=your-clever-mysql-host
DB_PORT=3306
DB_USER=your-clever-mysql-user
DB_PASSWORD=your-clever-mysql-password
DB_NAME=your-clever-mysql-database

# Option 2: variables Clever Cloud aussi supportees automatiquement
# MYSQL_ADDON_HOST=
# MYSQL_ADDON_PORT=
# MYSQL_ADDON_USER=
# MYSQL_ADDON_PASSWORD=
# MYSQL_ADDON_DB=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRY=30d

# API Configuration
API_URL=https://votre-backend.onrender.com

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=debug
