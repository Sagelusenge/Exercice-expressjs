# Environment
NODE_ENV=production
PORT=8080
APP_NAME=KBS Buildings

# Frontend URL
FRONTEND_URL=https://votre-frontend.onrender.com
CORS_ORIGIN=https://votre-frontend.onrender.com

# Database Configuration - Aiven / Render / Clever Cloud
# Option 1: variables classiques
DB_HOST=your-aiven-mysql-host
DB_PORT=10396
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true
# In production, prefer DB_SSL_CA=/path/to/ca.pem and DB_SSL_REJECT_UNAUTHORIZED=true.
DB_SSL_REJECT_UNAUTHORIZED=false

# Option 2: variables Clever Cloud aussi supportees automatiquement
# MYSQL_ADDON_HOST=
# MYSQL_ADDON_PORT=
# MYSQL_ADDON_USER=
# MYSQL_ADDON_PASSWORD=
# MYSQL_ADDON_DB=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRY=30d
BCRYPT_ROUNDS=10
# Temporary fallback while SMTP delivery is being verified.
AUTH_EXPOSE_VERIFICATION_CODE=false

# API Configuration
API_URL=https://votre-backend.onrender.com

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=debug
